# Kopieren nach deploy/.env und ausfüllen. deploy/.env nie einchecken.

# Domain ohne https://, DNS (A und AAAA) muss auf den Server zeigen
DOMAIN=leaqizz.com

# Lang und zufällig, z. B.: openssl rand -base64 32
POSTGRES_PASSWORD=

# Schlüssel für Anmeldesitzungen, lang und zufällig: openssl rand -base64 32
# Ändern meldet alle Lehrkräfte ab.
BETTER_AUTH_SECRET=

# Mailversand der Anmeldelinks (Hetzner Webhosting S, D-44): Postfach z. B. noreply@leaqizz.com.
# Postausgangsserver und Zugangsdaten aus konsoleH übernehmen. Port 587 (STARTTLS);
# Port 25 und 465 sind auf Hetzner-Cloud-Servern ausgehend gesperrt.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=leaqizz <noreply@leaqizz.com>

# Suchmaschinen: nein, bis leaqizz echt online ist (D-46). Dann ja.
# Auch mit ja bleiben Spielleitung und Verbindungstest gesperrt (bestätigt).
LEAQIZ_INDEXIERBAR=nein

# Versionsnummer für Cache-Busting, z. B. der Git-Commit: VERSION=$(git rev-parse --short HEAD)
VERSION=dev
