# HTTPS mit automatischem Zertifikat (Let's Encrypt). WebSocket wird durchgereicht.
# Kein Zugriffslog: IP-Adressen werden hier nicht gespeichert.
{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3000
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
