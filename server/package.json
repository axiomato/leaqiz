{
  "name": "leaqiz-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spielserver für leaqizz: liefert die Seiten aus und führt Live-Spiele über WebSocket, Zustand in PostgreSQL.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test test/*.test.js",
    "db:generate": "drizzle-kit generate",
    "lasttest": "node scripts/lasttest.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/static": "^10.1.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
