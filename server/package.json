{
  "name": "leaqiz-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spielserver für leaqizz: liefert die Seiten aus und führt Live-Spiele über WebSocket, Zustand in PostgreSQL.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "db:generate": "npm install --no-save drizzle-kit@0.31.11 && drizzle-kit generate",
    "lasttest": "node scripts/lasttest.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@better-auth/passkey": "^1.7.27",
    "@fastify/static": "^10.1.12",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "ws": "^8.23.0"
  }
}
